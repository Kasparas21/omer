{
  "name": "unfair-weekend",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/v1/collect/*"]
  },
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "91001", "simple": { "limit": 5, "period": 60 } },
    { "name": "COLLECT_LIMIT", "namespace_id": "91002", "simple": { "limit": 60, "period": 60 } }
  ]
}
