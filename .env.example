DATABASE_URL=postgres://unfairweekend:local-only@127.0.0.1:5432/unfairweekend
APP_URL=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
ALLOW_LOCAL_SITES=true

# Paste Google OAuth credentials here (optional until set).
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web).
# Authorized redirect URIs:
#   http://localhost:5173/api/auth/callback/google
#   https://app.tryomer.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI Platform key for replay summaries (Decisions + Responses, gpt-6-luna).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Firecrawl — scrape the store for Brand knowledge import.
# https://docs.firecrawl.dev
FIRECRAWL_API_KEY=

# Amazon SES (eu-north-1). IAM needs ses:SendEmail, ses:SendRawEmail,
# ses:CreateEmailIdentity, ses:GetEmailIdentity, ses:DeleteEmailIdentity.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
SES_FROM_EMAIL=noreply@your-verified-domain.com
# SES_FROM_DOMAIN=your-verified-domain.com
# SES_CONFIGURATION_SET=

# Optional platform Resend key (fallback). Merchants can also paste their own
# Resend or Postmark key in Settings → Sending (BYO). Keys are sealed with BETTER_AUTH_SECRET.
# https://resend.com/api-keys
RESEND_API_KEY=

# See docs/ses-iam-domain.md for CreateEmailIdentity / GetEmailIdentity IAM.

# Stripe revenue integrations: merchants paste their own restricted key in
# Settings → Integrations (sealed with BETTER_AUTH_SECRET). No platform Stripe key required.
